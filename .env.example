# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ and reads them at startup,
# so restart `npm run dev` after any change.

# EmailJS (https://www.emailjs.com/) — all three required to enable email delivery.
# When any is missing, the app falls back to a formatted WhatsApp message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# WhatsApp number in international format, digits only (no +, spaces, or leading 0).
VITE_WHATSAPP_NUMBER=2348154780923
